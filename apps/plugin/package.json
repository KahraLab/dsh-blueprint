{
  "name": "@local/dsh-blueprint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Blueprint：DSH 右侧栏里的产品原型工作台",
  "exports": {
    ".": "./lib/host/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "bp": "./lib/bin/bp.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "dependencies": {
    "citty": "^0.2.2",
    "lucide-react": "^1.62.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "main": "lib/host/index.js"
}
